generator client {
  provider = "prisma-client-js"
  output   = "./generated/tournament"
}

datasource db {
  provider = "sqlite"
  url      = env("TOURNAMENT_URL")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model K2P {
  rank    Int?
  pokemon String?
  score   Int?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model K2P_KPtop10 {
  rank    Int?
  pokemon String?
  score   Int?

  @@ignore
}

