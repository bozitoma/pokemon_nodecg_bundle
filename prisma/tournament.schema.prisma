model Party {
  id          Int     @id @default(autoincrement())
  accountID   String?
  player_name String?
  pokemon1    String?
  pokemon2    String?
  pokemon3    String?
  pokemon4    String?
  pokemon5    String?
  pokemon6    String?
}

model Player {
  id          Int     @id @default(autoincrement())
  accountID   String?
  player_name String?
  party_img   String?
  status      String?
}

model Pokemon {
  id           Int     @id @default(autoincrement())
  accountID    String?
  player_name  String?
  pokemon_name String?
  gender       String?
  type1        String?
  type2        String?
  teraType     String?
  ability      String?
  item         String?
  move1        String?
  move2        String?
  move3        String?
  move4        String?
}

model Ranking {
  id       Int     @id @default(autoincrement())
  pokemon  String?
  item     Bytes?
  ability  Bytes?
  teraType Bytes?
  move     Bytes?
}
