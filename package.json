{
  "name": "pokemon",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:tsc": "tsc -b src/browser src/extension -w --preserveWatchOutput",
    "dev:vite": "vite",
    "dev:nodecg": "onchange extension schema configschema.json -ik -- node --enable-source-maps ../..",
    "build": "tsc && vite build",
    "watch": "vite build --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "nodecg": {
    "compatibleRange": "2.1.11",
    "dashboardPanels": [
      {
        "name": "Scoreboard_pokemon",
        "title": "1.Scoreboard",
        "file": "scoreboard.html",
        "fullbleed": true,
        "headerColor": "#525F78"
      },
      {
        "name": "database_pokemon",
        "title": "2.database",
        "file": "database_table.html",
        "fullbleed": true,
        "headerColor": "#525F78"
      },
      {
        "name": "bracket_pokemon",
        "title": "3.bracket",
        "file": "bracket.html",
        "fullbleed": true,
        "headerColor": "#525F78"
      }
    ],
    "graphics": [
      {
        "file": "scoreboard.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "kpRanking.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "bracket.html",
        "width": 1920,
        "height": 1080
      }
    ]
  },
  "dependencies": {
    "@apollo/client": "^3.8.5",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.14",
    "@mui/lab": "^5.0.0-alpha.167",
    "@mui/material": "^5.14.10",
    "@mui/x-data-grid": "^6.19.6",
    "@prisma/client": "^5.10.2",
    "@rive-app/react-canvas": "^4.8.3",
    "better-sqlite3": "^8.7.0",
    "express": "^4.18.3",
    "graphql": "^16.8.1",
    "onchange": "^7.1.0",
    "prisma": "^5.10.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recoil": "^0.7.7",
    "use-immer": "^0.9.0"
  },
  "devDependencies": {
    "@nodecg/types": "^2.1.11",
    "@types/better-sqlite3": "^7.6.9",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react-swc": "^3.3.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "globby": "^13.1.4",
    "prettier": "2.8.8",
    "rollup-plugin-esbuild": "^5.0.0",
    "rollup-plugin-node-externals": "^5.1.2",
    "ts-nodecg": "^0.3.1",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  },
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
