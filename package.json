{
  "name": "pokemon",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:tsc": "tsc -b src/browser src/extension -w --preserveWatchOutput",
    "dev:vite": "vite",
    "dev:nodecg": "onchange extension schema configschema.json -ik -- node --enable-source-maps ../..",
    "build": "tsc && vite build",
    "watch": "vite build --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prisma:generate:pokedex": "prisma generate --schema prisma/pokedex.schema.prisma",
    "prisma:generate:tournament": "prisma generate --schema prisma/tournament.schema.prisma",
    "prisma:generate": "run-p prisma:generate:pokedex prisma:generate:tournament",
    "prisma:studio:pokedex": "prisma studio --schema prisma/pokedex.schema.prisma",
    "prisma:studio:tournament": "prisma studio --schema prisma/tournament.schema.prisma"
  },
  "nodecg": {
    "compatibleRange": "^1.0.0 || ^2.0.0",
    "dashboardPanels": [
      {
        "name": "Pokemon_scoreboard",
        "title": "1 | Scoreboard",
        "file": "scoreboard.html",
        "fullbleed": true,
        "headerColor": "#525F78"
      },
      {
        "name": "Pokemon_topcut",
        "title": "2 | Topcut",
        "file": "topcut.html",
        "fullbleed": true,
        "headerColor": "#525F78"
      },
      {
        "name": "Pokemon_data",
        "title": "3 | Data",
        "file": "pokemon_data.html",
        "fullbleed": true,
        "headerColor": "#525F78"
      }
    ],
    "graphics": [
      {
        "file": "scoreboard.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "pokemon_ranking.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "kpRanking.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "kpRanking31_60.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "kpRanking60_86.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "topcut_party.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "legendaryRanking1-5.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "legendaryRanking6-10.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "legendaryRanking11-15.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "bracket.html",
        "width": 1920,
        "height": 1080
      }
    ]
  },
  "dependencies": {
    "@mui/icons-material": "^5.15.14",
    "@mui/lab": "^5.0.0-alpha.167",
    "@mui/material": "^5.14.10",
    "@mui/x-data-grid": "^6.19.6",
    "@prisma/client": "^6.4.1",
    "@rive-app/react-canvas": "^4.8.3",
    "dotenv": "^16.4.7",
    "express": "^4.18.3",
    "jotai": "^2.10.3",
    "onchange": "^7.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@nodecg/types": "^2.1.11",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react-swc": "^3.3.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "globby": "^13.2.2",
    "npm-run-all": "^4.1.5",
    "prettier": "2.8.8",
    "prisma": "^6.4.1",
    "rollup-plugin-esbuild": "^5.0.0",
    "rollup-plugin-node-externals": "^5.1.2",
    "ts-nodecg": "^0.3.1",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  },
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
